+def make_wandb_logger(project: str, experiment_log_dir: str, **init_kwargs: Any):
+    return WandbLogger(
+        project=project, experiment_log_dir=experiment_log_dir, **init_kwargs
+    )
+
+
+def _to_loggable_scalar(x: Scalar):
+    """Best-effort convert a Tensor/ndarray scalar to a plain float for wandb.
+
+    wandb.log accepts plain Python numbers reliably; a multi-element Tensor or
+    ndarray isn't a scalar to begin with, so it's passed through unchanged and
+    left to wandb's own (de)serialization.
+    """
+    try:
+        return float(x)
+    except (TypeError, ValueError):
+        return x
+
+
+class WandbLogger:
+    """
+    A thin wrapper around a wandb run, matching TensorBoardLogger's interface
+    (log/log_dict/log_hparams) so `Logger` can forward to both identically.
+
+    Only rank 0 opens a run — mirrors TensorBoardWriterWrapper, since wandb.log
+    calls from every DDP rank would otherwise race against the same run.
+    """
+
+    def __init__(
+        self,
+        project: str,
+        experiment_log_dir: str,
+        job_type: Optional[str] = None,
+        **init_kwargs: Any,
+    ) -> None:
+        self._run = None
+        _, self._rank = get_machine_local_and_dist_rank()
+        if self._rank != 0:
+            logging.debug(
+                f"Not logging to wandb on this host because env RANK: {self._rank} != 0"
+            )
+            return
+        if wandb is None:
+            logging.warning(
+                "logging.wandb_writer is configured but the `wandb` package is not "
+                "installed — skipping wandb logging for this run."
+            )
+            return
+        # name = this run's own experiment dir (e.g. aw3813/experiments/<run_name>),
+        # not the log_dir passed to TensorBoard, which also has /logs/<supercategory>
+        # appended and would make every dataset within a run look like a separate run.
+        self._run = wandb.init(
+            project=project,
+            name=Path(experiment_log_dir).name,
+            job_type=job_type,
+            **init_kwargs,
+        )
+        atexit.register(self.close)
+
+    def log_dict(self, payload: Dict[str, Scalar], step: int) -> None:
+        if not self._run:
+            return
+        self._run.log(
+            {k: _to_loggable_scalar(v) for k, v in payload.items()}, step=step
+        )
+
+    def log(self, name: str, data: Scalar, step: int) -> None:
+        if not self._run:
+            return
+        self._run.log({name: _to_loggable_scalar(data)}, step=step)
+
+    def log_hparams(
+        self, hparams: Dict[str, Scalar], meters: Dict[str, Scalar]
+    ) -> None:
+        if not self._run:
+            return
+        self._run.config.update(hparams, allow_val_change=True)
+
+    def close(self) -> None:
+        if not self._run:
+            return
+        self._run.finish()
+        self._run = None
+
